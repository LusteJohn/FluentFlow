{
  "expo": {
    "name": "FluentFlow",
    "slug": "FluentFlow",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "fluentflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.png"
    },
    "android": {
      "icon": "./assets/images/logo.png",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo.png",
        "monochromeImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thy.johnmark23.FluentFlow"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "590cf1eb-4ade-4962-afed-18059f7adc9c"
      }
    }
  }
}
